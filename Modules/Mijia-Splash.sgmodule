# GPL-3.0，见 LICENSES/GPL-3.0.txt；改用小火箭原生 reject-dict 并合并开屏接口正则。

[URL Rewrite]
# 合并普通与实时开屏广告接口，返回空 JSON
^https?:\/\/home\.mi\.com\/cgi-op\/api\/v1\/(?:recommendation|resource\/realtime)\/openingBanner(?:\/|\?|$) - reject-dict

[MITM]
hostname = %APPEND% home.mi.com
