#!name=高德地图开屏去广告
#!desc=精准拦截高德开屏广告接口并返回空 JSON，不触碰定位与核心业务。需开启 HTTPS 解密并信任证书。
#!author=zhangbao20-sina（基于 fmz200/wool_scripts 适配）
#!homepage=https://github.com/zhangbao20-sina/Shadowrocket-Config
#!url=https://raw.githubusercontent.com/zhangbao20-sina/Shadowrocket-Config/main/Modules/Amap-Local.sgmodule
#!update-url=https://raw.githubusercontent.com/zhangbao20-sina/Shadowrocket-Config/main/Modules/Amap-Local.sgmodule

# 策略说明：
# 1. 仅拦截纯广告域名与开屏接口，不整段拦截 /ws/valueadded/ 或 startup/init。
# 2. 不使用通配 MITM 主机名，不触碰 WLOC 的 bluedot.is.autonavi.com。

[Rule]
# 纯广告域名，无需 MITM 直接拒绝
DOMAIN,optimus-ads.amap.com,REJECT
# 强制广告接口域名回退 TCP，防止 QUIC(HTTP/3) 绕过 MITM（如无漏网可注释掉）
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN,m5.amap.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN,amap-aos-info-nogw.amap.com)),REJECT-NO-DROP

[URL Rewrite]
# 合并 aos 与 valueadded 两个路径的开屏接口，统一返回空 JSON
^https?:\/\/(?:m5(?:-zb)?|center|amap-aos-info-nogw|ai)\.amap\.com\/ws\/(?:aos|valueadded)\/alimama\/splash_screen(?:_rt)?(?:\/|\?|$) - reject-dict

[MITM]
hostname = %APPEND% m5.amap.com, m5-zb.amap.com, center.amap.com, amap-aos-info-nogw.amap.com, ai.amap.com
