#!version=2026.09.22

# 个人维护适配版本
# 设计目标：
# - 模块只负责较明确的广告 / 竞价 / 展示类请求拦截
# - Talkatone 业务分流统一交给本地配置 TALKATONE_NODE
# - 不在模块内指定 PROXY / DIRECT
# - 不启用 URL Rewrite / MITM
# - 避免阻断 Firebase、Crashlytics、Adjust 等共享服务

[Rule]

# =========================
# Talkatone 广告相关规则
# =========================

