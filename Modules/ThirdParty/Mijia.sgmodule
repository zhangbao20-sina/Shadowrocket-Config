#!url=https://raw.githubusercontent.com/zhangbao20-sina/Shadowrocket-Config/main/Modules/ThirdParty/Mijia.sgmodule
#!update-url=https://raw.githubusercontent.com/zhangbao20-sina/Shadowrocket-Config/main/Modules/ThirdParty/Mijia.sgmodule

[Rule]
DOMAIN,sdkconfig.ad.xiaomi.com,REJECT

[Map Local]
^https?:\/\/home\.mi\.com\/cgi-op\/api\/v1\/recommendation\/(banner|carousel\/banners|myTab|openingBanner) data-type=text data="{}" header="Content-Type:application/json"

^https?:\/\/home\.mi\.com\/cgi-op\/api\/v1\/resource\/realtime\/openingBanner data-type=text data="{}" header="Content-Type:application/json"

[MITM]
hostname = %APPEND% home.mi.com

